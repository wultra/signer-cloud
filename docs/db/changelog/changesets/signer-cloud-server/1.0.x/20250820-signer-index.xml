                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1" logicalFilePath="signer-cloud-server/1.0.x/20250820-signer-index" author="Lubos Racansky">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="sc_signer_status_idx" tableName="sc_signer" />
