<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.30.xsd">

    <changeSet id="1" logicalFilePath="signer-cloud-server/1.0.x/20260105-rename-custom-columns.xml" author="Michal Rozehnal">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="sc_signer" columnName="custom_user_id"/>
            </not>
        </preConditions>
        <comment>Rename column from "user_id" to "custom_user_id"</comment>
        <renameColumn tableName="sc_signer" oldColumnName="user_id" newColumnName="custom_user_id" />
    </changeSet>

    <changeSet id="2" logicalFilePath="signer-cloud-server/1.0.x/20260105-rename-custom-columns.xml" author="Michal Rozehnal">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="sc_document" columnName="custom_document_id"/>
            </not>
        </preConditions>
        <comment>Rename column from "external_id" to "custom_document_id"</comment>
        <renameColumn tableName="sc_document" oldColumnName="external_id" newColumnName="custom_document_id" />
    </changeSet>

</databaseChangeLog>