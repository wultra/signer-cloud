<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.30.xsd">

    <changeSet id="1" logicalFilePath="signer-cloud-server/1.0.x/20260810-signing-transaction-id-name-nullable.xml" author="Michal Rozehnal">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="signing_transaction" columnName="external_id"/>
        </preConditions>
        <dropNotNullConstraint tableName="signing_transaction" columnName="external_id" columnDataType="VARCHAR(128)"/>
    </changeSet>

    <changeSet id="2" logicalFilePath="signer-cloud-server/1.0.x/20260810-signing-transaction-id-name-nullable.xml" author="Michal Rozehnal">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="signing_transaction" columnName="document_name"/>
        </preConditions>
        <dropNotNullConstraint tableName="signing_transaction" columnName="document_name" columnDataType="VARCHAR(255)"/>
    </changeSet>

</databaseChangeLog>