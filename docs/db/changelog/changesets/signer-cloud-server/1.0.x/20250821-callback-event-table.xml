<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1" logicalFilePath="signer-cloud-server/1.0.x/20250821-callback-event-table.xml" author="Lubos Racansky">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="sc_callback_event" />
            </not>
        </preConditions>
        <comment>Create a new table sc_callback_event</comment>
        <createTable tableName="sc_callback_event">
            <column name="id" type="bigint">
                <constraints primaryKey="true" />
            </column>
            <column name="callback_type" type="varchar(32)">
                <constraints nullable="false" />
            </column>
            <column name="callback_data" type="text">
                <constraints nullable="false" />
            </column>
            <column name="status" type="varchar(32)" >
                <constraints nullable="false" />
            </column>
            <column name="timestamp_created" type="timestamp(6)" defaultValueComputed="${now}">
                <constraints nullable="false" />
            </column>
            <column name="timestamp_last_call" type="timestamp(6)" />
            <column name="timestamp_next_call" type="timestamp(6)" />
            <column name="timestamp_delete_after" type="timestamp(6)" />
            <column name="timestamp_rerun_after" type="timestamp(6)" />
            <column name="attempts" type="integer" defaultValueNumeric="0">
                <constraints nullable="false" />
            </column>
            <column name="idempotency_key" type="varchar(36)" >
                <constraints nullable="false" />
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2" logicalFilePath="signer-cloud-server/1.0.x/20250821-callback-event-table.xml" author="Lubos Racansky">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="sc_callback_event_status_idx"/>
            </not>
        </preConditions>
        <comment>Create a new index on sc_callback_event(status).</comment>
        <createIndex tableName="sc_callback_event" indexName="sc_callback_event_status_idx">
            <column name="status" />
        </createIndex>
    </changeSet>

    <changeSet id="3" logicalFilePath="signer-cloud-server/1.0.x/20250821-callback-event-table.xml" author="Lubos Racansky">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="sc_callback_event_timestamp_delete_after_idx"/>
            </not>
        </preConditions>
        <comment>Create a new index on sc_callback_event(timestamp_delete_after).</comment>
        <createIndex tableName="sc_callback_event" indexName="sc_callback_event_timestamp_delete_after_idx">
            <column name="timestamp_delete_after" />
        </createIndex>
    </changeSet>

    <changeSet id="4" logicalFilePath="signer-cloud-server/1.0.x/20250821-callback-event-table.xml" author="Lubos Racansky">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="sc_callback_event_callback_type_idx"/>
            </not>
        </preConditions>
        <comment>Create a new index on sc_callback_event(callback_type).</comment>
        <createIndex tableName="sc_callback_event" indexName="sc_callback_event_callback_type_idx">
            <column name="callback_type" />
        </createIndex>
    </changeSet>

    <changeSet id="5" logicalFilePath="signer-cloud-server/1.0.x/20250821-callback-event-table.xml" author="Lubos Racansky">
        <preConditions onFail="MARK_RAN">
            <not>
                <sequenceExists sequenceName="sc_callback_event_seq"/>
            </not>
        </preConditions>
        <comment>Create a new sequence sc_callback_event_seq</comment>
        <createSequence sequenceName="sc_callback_event_seq" startValue="1" incrementBy="1" cacheSize="50"/>
    </changeSet>

    <changeSet id="6" logicalFilePath="signer-cloud-server/1.0.x/20250821-callback-event-table.xml" author="Lubos Racansky">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="sc_callback_event" columnName="type" />
            </not>
        </preConditions>
        <comment>Drop the column callback_type from sc_callback_event</comment>
        <dropColumn tableName="sc_callback_event" columnName="callback_type" />
    </changeSet>

</databaseChangeLog>