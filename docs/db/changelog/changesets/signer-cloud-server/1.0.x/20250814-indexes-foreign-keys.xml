<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="1" logicalFilePath="signer-cloud-server/1.0.x/20250814-indexes-foreign-keys.xml" author="Michal Rozehnal">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="sc_document_signer_id_idx"/>
            </not>
        </preConditions>
        <comment>Create a new index sc_document_signer_id_idx</comment>
        <createIndex tableName="sc_document" indexName="sc_document_signer_id_idx">
            <column name="signer_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="2" logicalFilePath="signer-cloud-server/1.0.x/20250814-indexes-foreign-keys.xml" author="Michal Rozehnal">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="sc_document_document_content_id_idx"/>
            </not>
        </preConditions>
        <comment>Create a new index sc_document_document_content_id_idx</comment>
        <createIndex tableName="sc_document" indexName="sc_document_document_content_id_idx">
            <column name="document_content_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>