<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1" logicalFilePath="signer-cloud-server/1.0.x/20250904-callback.xml" author="Lubos Racansky">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="sc_callback"/>
            </not>
        </preConditions>
        <comment>Create a new table sc_callback</comment>
        <createTable tableName="sc_callback">
            <column name="id" type="bigint">
                <constraints primaryKey="true" />
            </column>
            <column name="callback_url" type="varchar(1024)">
                <constraints nullable="false" />
            </column>
            <column name="callback_type" type="varchar(64)">
                <constraints nullable="false" />
            </column>
            <column name="authentication" type="text" />
            <column name="max_attempts" type="integer" />
            <column name="initial_backoff" type="varchar(64)" />
            <column name="retention_period" type="varchar(64)" />
            <column name="encryption_mode" defaultValue="NO_ENCRYPTION" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="timestamp_created" type="timestamp(6)" defaultValueComputed="${now}">
                <constraints nullable="false" />
            </column>
            <column name="timestamp_last_updated" type="timestamp(6)" />
        </createTable>
    </changeSet>

    <changeSet id="2" logicalFilePath="signer-cloud-server/1.0.x/20250904-callback.xml" author="Lubos Racansky">
        <preConditions onFail="MARK_RAN">
            <not>
                <sequenceExists sequenceName="sc_callback_seq"/>
            </not>
        </preConditions>
        <comment>Create a new sequence sc_callback_seq</comment>
        <createSequence sequenceName="sc_callback_seq" startValue="1" incrementBy="1" cacheSize="50"/>
    </changeSet>

    <changeSet id="3" logicalFilePath="signer-cloud-server/1.0.x/20250904-callback.xml" author="Lubos Racansky">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="sc_callback_event" columnName="callback_id"/>
            </not>
        </preConditions>
        <comment>Create a new column sc_callback_event.callback_id</comment>
        <addColumn tableName="sc_callback_event">
            <column name="callback_id" type="bigint">
                <constraints nullable="false" foreignKeyName="sc_callback_event_callback_id_fk" referencedTableName="sc_callback" referencedColumnNames="id" />
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>