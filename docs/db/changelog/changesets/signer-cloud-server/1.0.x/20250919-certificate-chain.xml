<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1" logicalFilePath="signer-cloud-server/1.0.x/20250919-certificate-chain.xml" author="Michal Rozehnal">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="sc_signer"/>
                <not>
                    <columnExists tableName="sc_signer" columnName="certificate_chain"/>
                </not>
            </and>
        </preConditions>
        <comment>Create a new index column certificate_chain</comment>
        <addColumn tableName="sc_signer">
            <column name="certificate_chain" type="clob">
                <constraints nullable="false" />
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>